{
  "name": "@support-helper/sdk-web",
  "version": "0.1.0",
  "description": "Support Helper SDK for web applications",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.es.js",
      "require": "./dist/widget.cjs.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.es.js",
      "require": "./dist/react.cjs.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.es.js",
      "require": "./dist/vue.cjs.js"
    },
    "./cdn": {
      "default": "./dist/cdn/sdk.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:cdn": "vite build --config vite.config.cdn.ts",
    "build:all": "pnpm build && pnpm build:cdn",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@support-helper/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "terser": "^5.27.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^1.1.0"
  },
  "keywords": [
    "support",
    "sdk",
    "video-capture",
    "bug-reporting",
    "feedback",
    "web-component",
    "custom-element"
  ],
  "author": "Support Helper Team",
  "license": "MIT",
  "sideEffects": [
    "./dist/widget.es.js",
    "./dist/widget.cjs.js",
    "./dist/cdn/sdk.iife.js"
  ]
}
