# ===========================================
# Support Helper Platform - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# Variables marked REQUIRED must be set before the application can start.
# Variables marked (optional) have sensible defaults or enable optional features.

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Docker Compose defaults for local development
POSTGRES_USER=support
POSTGRES_PASSWORD=support123
POSTGRES_DB=support_helper
# REQUIRED: Full connection string used by Prisma ORM
DATABASE_URL=postgresql://support:support123@localhost:5432/support_helper

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379
# REQUIRED in production (docker-compose.prod.yml)
REDIS_PASSWORD=

# ===========================================
# Auth / JWT
# ===========================================
# REQUIRED: Access token signing key (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (default: 30m)
JWT_EXPIRES_IN=30m
# REQUIRED: Refresh token signing key (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=
# Refresh token lifetime (default: 30d)
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# AI Providers (configure at least one)
# ===========================================
# Anthropic (Claude) - recommended, supports vision + completions
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# OpenAI - alternative provider, also needed for embeddings
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
# (optional) Embedding model for codebase indexing (default: text-embedding-3-small)
EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# S3 / MinIO (Object Storage)
# ===========================================
# Docker Compose defaults for local development
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# S3-compatible endpoint used by the API and Worker (AWS SDK standard naming)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=videos
S3_REGION=us-east-1

# ===========================================
# MeiliSearch (Full-text Search)
# ===========================================
MEILISEARCH_HOST=http://localhost:7700
# API uses MEILISEARCH_MASTER_KEY, worker uses MEILISEARCH_API_KEY
# Set both to the same value for consistency
MEILISEARCH_MASTER_KEY=masterkey_dev_only

# ===========================================
# Email
# ===========================================
# Development: MailHog captures all emails (no real delivery)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@support-helper.local
# Production: Resend transactional email service (used by worker)
# RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM_EMAIL=support@yourdomain.com

# ===========================================
# GitHub OAuth (optional - legacy user-token flow)
# ===========================================
# To enable GitHub OAuth integration:
# 1. Create an OAuth App at: https://github.com/settings/developers
# 2. Set Authorization callback URL to: http://localhost:3001/api/github/oauth/callback
# 3. Copy the Client ID and generate a Client Secret
# 4. Set the values below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Webhook signature verification secret
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ===========================================
# GitHub App (optional - installation-based flow)
# ===========================================
# To enable GitHub App integration:
# 1. Create a GitHub App at: https://github.com/settings/apps/new
# 2. Set Webhook URL to: http://localhost:3001/api/github/webhooks
# 3. Generate a private key and download the .pem file
# 4. Set GITHUB_APP_ID from the App settings page
# 5. Set GITHUB_PRIVATE_KEY (paste PEM contents, replace newlines with \n)
# 6. Set GITHUB_APP_NAME to the app slug (URL-friendly name)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# ===========================================
# Encryption (Data at rest)
# ===========================================
# REQUIRED: 32-byte key for encrypting sensitive data at rest (GitHub tokens, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ===========================================
# Integrations (Third-party sync)
# ===========================================
# To enable GitHub App integration:
# 1. Create a GitHub App at: https://github.com/settings/apps/new
# 2. Set Webhook URL to: http://localhost:3001/api/github/webhooks
# 3. Generate a private key and download the .pem file
# 4. Set GITHUB_APP_ID from the App settings page
# 5. Set GITHUB_PRIVATE_KEY (paste PEM contents, replace newlines with \n)
# 6. Set GITHUB_APP_NAME to the app slug (URL-friendly name)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# ===========================================
# Encryption (Data at Rest)
# ===========================================
# REQUIRED: 32-byte hex key for encrypting sensitive data (GitHub tokens, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# REQUIRED: 32-byte hex key for encrypting third-party integration credentials
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# ===========================================
# App Config
# ===========================================
NODE_ENV=development
# API backend port
API_PORT=3001
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3001
# (optional) Worker uses this for ticket links in notifications
# APP_URL=http://localhost:3000

# ===========================================
# Frontend (Next.js public env vars)
# ===========================================
# API URL accessible from the browser (dashboard + web app)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===========================================
# Worker Config
# ===========================================
# Worker HTTP port (default: 3003)
# WORKER_PORT=3003
# Max concurrent BullMQ jobs (default: 10)
# WORKER_CONCURRENCY=10
# YOLO model path for UI element detection (optional)
# YOLO_WEIGHTS_PATH=./models/yolov11n.pt

# ===========================================
# Production Ports (docker-compose.prod.yml)
# ===========================================
# Override default ports for production deployment
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ===========================================
# Monitoring - Logging
# ===========================================
# Log level: error, warn, info, debug (default: info)
LOG_LEVEL=info
# Enable structured JSON logging (default: false in dev, true in prod)
LOG_FORMAT=json

# ===========================================
# Monitoring - Prometheus Metrics
# ===========================================
# Enable Prometheus metrics endpoint at GET /metrics (default: false)
PROMETHEUS_ENABLED=false

# ===========================================
# Production Ports (docker-compose.prod.yml)
# ===========================================
# Override default ports for production deployment
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ===========================================
# Monitoring - Sentry (Error Tracking)
# ===========================================
# (optional) Get DSN from https://sentry.io
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Dashboard (client-side)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# Monitoring - Better Stack (Logs)
# ===========================================
# (optional) Get token from https://betterstack.com
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_ENDPOINT=https://in.logs.betterstack.com

# ===========================================
# Monitoring - PostHog (Analytics)
# ===========================================
# (optional) Get key from https://posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Dashboard (client-side)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_DEV=false

# ===========================================
# Uptime Monitoring
# ===========================================
UPTIME_MONITORING_ENABLED=false
UPTIME_WEBHOOK_URL=

# ===========================================
# Database Backups
# ===========================================
# S3 bucket for database backups (required for automated backups)
BACKUP_BUCKET=

# Slack webhook for backup notifications (optional)
# Create webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Dead Letter Queue Alerts (optional)
# Email address to receive DLQ failure alerts
DLQ_ALERT_EMAIL=
# Slack webhook URL for DLQ alerts (optional)
DLQ_SLACK_WEBHOOK_URL=

# Note: AWS credentials for backups use the same variables as S3:
# - S3_ACCESS_KEY_ID (from S3 section above)
# - S3_SECRET_ACCESS_KEY (from S3 section above)
# - S3_REGION (from S3 section above)
#
# Required GitHub Secrets for automated backups workflow:
# - BACKUP_BUCKET (S3 bucket name)
# - PRODUCTION_DATABASE_URL (or individual POSTGRES_* variables)
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - AWS_REGION (optional, defaults to us-east-1)
# - SLACK_WEBHOOK_URL (optional)
