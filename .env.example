# ===========================================
# Database (docker-compose defaults)
# ===========================================
POSTGRES_USER=support
POSTGRES_PASSWORD=support123
POSTGRES_DB=support_helper
DATABASE_URL=postgresql://support:support123@localhost:5432/support_helper

# Redis
REDIS_URL=redis://localhost:6379

# ===========================================
# Auth
# ===========================================
# REQUIRED: Generate with `openssl rand -hex 32`
JWT_SECRET=
JWT_EXPIRES_IN=30m
# REQUIRED in production: Generate with `openssl rand -hex 32`
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# S3 / MinIO (docker-compose defaults)
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=videos
S3_REGION=us-east-1

# ===========================================
# OpenAI (optional for MVP)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# Meilisearch (full-text search)
# ===========================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterkey_dev_only

# ===========================================
# Email (Mailhog for dev)
# ===========================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@support-helper.local

# ===========================================
# GitHub OAuth (optional - legacy user-token flow)
# ===========================================
# To enable GitHub OAuth integration:
# 1. Create an OAuth App at: https://github.com/settings/developers
# 2. Set Authorization callback URL to: http://localhost:3001/api/github/oauth/callback
# 3. Copy the Client ID and generate a Client Secret
# 4. Set the values below
# 5. Generate a random webhook secret: openssl rand -hex 32
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ===========================================
# GitHub App (optional - installation-based flow)
# ===========================================
# To enable GitHub App integration:
# 1. Create a GitHub App at: https://github.com/settings/apps/new
# 2. Set Webhook URL to: http://localhost:3001/api/github/webhooks
# 3. Generate a private key and download the .pem file
# 4. Set GITHUB_APP_ID from the App settings page
# 5. Set GITHUB_PRIVATE_KEY (paste PEM contents, replace newlines with \n)
# 6. Set GITHUB_APP_NAME to the app slug (URL-friendly name)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# ===========================================
# Integrations (Third-party sync)
# ===========================================
INTEGRATION_ENCRYPTION_KEY=generate-with-node-crypto-randomBytes-32

# ===========================================
# App
# ===========================================
NODE_ENV=development
API_PORT=3001
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3001

# ===========================================
# Monitoring - Sentry (Error Tracking)
# ===========================================
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Dashboard (client-side)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# Monitoring - Better Stack (Logs)
# ===========================================
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_ENDPOINT=https://in.logs.betterstack.com

# ===========================================
# Monitoring - PostHog (Analytics)
# ===========================================
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Dashboard (client-side)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_DEV=false

# ===========================================
# Uptime Monitoring
# ===========================================
UPTIME_MONITORING_ENABLED=false
UPTIME_WEBHOOK_URL=

# ===========================================
# Database Backups
# ===========================================
# S3 bucket for database backups (required for automated backups)
BACKUP_BUCKET=

# Slack webhook for backup notifications (optional)
# Create webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Note: AWS credentials for backups use the same variables as S3:
# - AWS_ACCESS_KEY_ID (from S3 section above)
# - AWS_SECRET_ACCESS_KEY (from S3 section above)
# - AWS_REGION (from S3 section above)
#
# Required GitHub Secrets for automated backups workflow:
# - BACKUP_BUCKET (S3 bucket name)
# - PRODUCTION_DATABASE_URL (or individual POSTGRES_* variables)
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - AWS_REGION (optional, defaults to us-east-1)
# - SLACK_WEBHOOK_URL (optional)

# ===========================================
# Rate Limiting
# ===========================================
# Comma-separated list of IP addresses to whitelist from rate limiting
# Example: 127.0.0.1,::1,192.168.1.100
RATE_LIMIT_WHITELIST=127.0.0.1,::1
