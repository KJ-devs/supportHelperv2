# ===========================================
# Database (docker-compose defaults)
# ===========================================
POSTGRES_USER=support
POSTGRES_PASSWORD=support123
POSTGRES_DB=support_helper
DATABASE_URL=postgresql://support:support123@localhost:5432/support_helper

# Redis
REDIS_URL=redis://localhost:6379

# ===========================================
# Auth
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# S3 / MinIO (docker-compose defaults)
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=videos
S3_REGION=us-east-1

# ===========================================
# OpenAI (optional for MVP)
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# Meilisearch (full-text search)
# ===========================================
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=masterkey_dev_only

# ===========================================
# Email (Mailhog for dev)
# ===========================================
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@support-helper.local

# ===========================================
# GitHub OAuth (optional)
# ===========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ===========================================
# Integrations (Third-party sync)
# ===========================================
INTEGRATION_ENCRYPTION_KEY=generate-with-node-crypto-randomBytes-32

# ===========================================
# App
# ===========================================
NODE_ENV=development
API_PORT=3001
DASHBOARD_URL=http://localhost:3000
API_URL=http://localhost:3001

# ===========================================
# Monitoring - Sentry (Error Tracking)
# ===========================================
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Dashboard (client-side)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# Monitoring - Better Stack (Logs)
# ===========================================
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_ENDPOINT=https://in.logs.betterstack.com

# ===========================================
# Monitoring - PostHog (Analytics)
# ===========================================
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
# Dashboard (client-side)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_DEV=false

# ===========================================
# Uptime Monitoring
# ===========================================
UPTIME_MONITORING_ENABLED=false
UPTIME_WEBHOOK_URL=
