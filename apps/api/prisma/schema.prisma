generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgvector(map: "vector")]
}

// ═══════════════════════════════════════════════════════════════════════
// MULTI-TENANT CORE
// ═══════════════════════════════════════════════════════════════════════

model Tenant {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String   @db.VarChar(255)
  slug             String   @unique @db.VarChar(100)
  plan             String   @default("free") @db.VarChar(50)
  settings         Json     @default("{}")
  stripeCustomerId String?  @map("stripe_customer_id") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users                   User[]
  applications            Application[]
  tickets                 Ticket[]
  githubConnections       GithubConnection[]
  githubInstallations     GithubInstallation[]
  integrations            Integration[]
  aiConfig                AiConfig?
  tenantQuota             TenantQuota?
  codebaseEmbeddings      CodebaseEmbedding[]
  agentTasks              AgentTask[]
  ticketEvents            TicketEvent[]
  notificationPreferences NotificationPreference[]
  notificationLogs        NotificationLog[]
  licenseUsage            LicenseUsage[]
  auditLogs               AuditLog[]
  ssoConfig               SsoConfig?
  archivedDeadLetterJobs  ArchivedDeadLetterJob[]
  ticketRelations         TicketRelation[]

  @@map("tenants")
}

model User {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  email          String   @db.VarChar(255)
  name           String?  @db.VarChar(255)
  role           String   @default("member") @db.VarChar(50)
  passwordHash   String?  @map("password_hash") @db.VarChar(255)
  authProvider   String?  @map("auth_provider") @db.VarChar(50)
  authProviderId String?  @map("auth_provider_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  reportedTickets  Ticket[]          @relation("ReportedTickets")
  assignedTickets  Ticket[]          @relation("AssignedTickets")
  escalatedSessions AgentSession[]
  feedbacks        ClassificationFeedback[]

  @@unique([tenantId, email])
  @@map("users")
}

model Application {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(255)
  platform   String?  @db.VarChar(50)
  sdkKey     String   @unique @map("sdk_key") @db.VarChar(255)
  settings   Json     @default("{}")
  githubRepo String?  @map("github_repo") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant                  Tenant               @relation(fields: [tenantId], references: [id])
  tickets                 Ticket[]
  githubConfigs           ProjectGithubConfig[]
  codebaseEmbeddings      CodebaseEmbedding[]
  codebaseIndexStatus     CodebaseIndexStatus?
  agentTasks              AgentTask[]
  notificationPreferences NotificationPreference[]

  @@map("applications")
}

enum TicketStatus {
  new
  open
  in_progress
  pending
  analyzing
  analyzed
  analysis_failed
  triaged
  waiting
  waiting_response
  escalated
  fix_proposed
  resolved
  merged
  closed
}

// ═══════════════════════════════════════════════════════════════════════
// TICKETS & REPORTS
// ═══════════════════════════════════════════════════════════════════════

model Ticket {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  applicationId      String    @map("application_id") @db.Uuid
  reporterId         String?   @map("reporter_id") @db.Uuid

  // Status & Classification
  status             TicketStatus @default(new)
  type               String?   @db.VarChar(50)
  typeConfidence     Decimal?  @map("type_confidence") @db.Decimal(3, 2)
  severity           String?   @db.VarChar(50)
  severityConfidence Decimal?  @map("severity_confidence") @db.Decimal(3, 2)
  priority           Int       @default(0)

  // Content
  title              String?   @db.VarChar(500)
  description        String?   @db.Text
  reproductionSteps  Json?     @map("reproduction_steps")

  // User Context
  userContext        Json?     @map("user_context")
  sessionId          String?   @map("session_id") @db.VarChar(255)

  // AI Analysis
  aiSummary          String?   @map("ai_summary") @db.Text
  aiAnalysis         Json?     @map("ai_analysis")
  keywords           String[]  @default([])

  // Public tracking
  publicId           String?   @unique @map("public_id") @db.VarChar(20)
  reopenToken        String?   @unique @map("reopen_token") @db.VarChar(255)

  // Assignment
  assignedTo         String?   @map("assigned_to") @db.Uuid
  assignedAt         DateTime? @map("assigned_at")

  // Timestamps
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  resolvedAt         DateTime? @map("resolved_at")

  // AI Diagnosis
  diagnosis          Json?     @map("diagnosis") @db.JsonB
  diagnosisUpdatedAt DateTime? @map("diagnosis_updated_at")

  // N1 Triage Assessment
  n1Assessment       Json?     @map("n1_assessment") @db.JsonB
  n1AssessedAt       DateTime? @map("n1_assessed_at")
  n1Decision         String?   @map("n1_decision") @db.VarChar(30)

  // Vector Embedding (pgvector) — unified to text-embedding-3-small (1536d)
  embedding          Unsupported("vector(1536)")?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  application   Application    @relation(fields: [applicationId], references: [id])
  reporter      User?          @relation("ReportedTickets", fields: [reporterId], references: [id])
  assignee      User?          @relation("AssignedTickets", fields: [assignedTo], references: [id])
  media                Media[]
  githubIssues         GithubIssue[]
  agentSessions        AgentSession[]
  feedbacks            ClassificationFeedback[]
  integrationSyncLogs  IntegrationSyncLog[]
  agentTasks           AgentTask[]
  ticketEvents         TicketEvent[]
  notificationLogs     NotificationLog[]
  ticketMessages       TicketMessage[]
  relationsAsSource    TicketRelation[] @relation("SourceTicket")
  relationsAsTarget    TicketRelation[] @relation("TargetTicket")

  @@index([tenantId])
  @@index([applicationId])
  @@index([status])
  @@index([type])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  // Composite indexes for common query patterns
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, assignedTo])
  @@index([applicationId, createdAt(sort: Desc)])
  @@map("tickets")
}

// ═══════════════════════════════════════════════════════════════════════
// MEDIA & ARTIFACTS
// ═══════════════════════════════════════════════════════════════════════

model Media {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  type             String   @db.VarChar(50)

  // Storage
  storageKey       String   @map("storage_key") @db.VarChar(500)
  storageUrl       String?  @map("storage_url") @db.VarChar(1000)
  fileSize         BigInt?  @map("file_size")
  mimeType         String?  @map("mime_type") @db.VarChar(100)
  durationMs       Int?     @map("duration_ms")

  // Processing Status
  processingStatus String   @default("pending") @map("processing_status") @db.VarChar(50)
  processingError  String?  @map("processing_error") @db.Text

  // Metadata
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  videoEvents VideoEvent[]

  @@index([ticketId])
  @@index([processingStatus])
  @@map("media")
}

model VideoEvent {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  mediaId       String   @map("media_id") @db.Uuid
  timestampMs   Int      @map("timestamp_ms")
  eventType     String?  @map("event_type") @db.VarChar(50)
  eventData     Json?    @map("event_data")
  screenshotKey String?  @map("screenshot_key") @db.VarChar(500)
  ocrText       String?  @map("ocr_text") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
  @@index([mediaId, timestampMs])
  @@map("video_events")
}

// ═══════════════════════════════════════════════════════════════════════
// GITHUB INTEGRATION
// ═══════════════════════════════════════════════════════════════════════

model GithubConnection {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  installationId BigInt    @map("installation_id")
  accessToken    String?   @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")
  repos          Json      @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("github_connections")
}

model GithubIssue {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId          String?  @map("ticket_id") @db.Uuid
  githubIssueNumber Int      @map("github_issue_number")
  githubRepo        String   @map("github_repo") @db.VarChar(255)
  githubIssueUrl    String?  @map("github_issue_url") @db.VarChar(500)
  syncStatus        String   @default("synced") @map("sync_status") @db.VarChar(50)
  lastSyncedAt      DateTime @default(now()) @map("last_synced_at")
  createdAt         DateTime @default(now()) @map("created_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@unique([githubRepo, githubIssueNumber])
  @@index([ticketId])
  @@map("github_issues")
}

model GithubInstallation {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  installationId BigInt    @unique @map("installation_id")
  accountLogin   String    @map("account_login")
  accountType    String    @map("account_type")
  permissions    Json      @default("{}")
  suspendedAt    DateTime? @map("suspended_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectConfigs ProjectGithubConfig[]

  @@map("github_installations")
}

model ProjectGithubConfig {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  installationId BigInt   @map("installation_id")
  owner          String
  repo           String
  defaultBranch  String   @default("main") @map("default_branch")
  isPrimary      Boolean  @default(false) @map("is_primary")
  role           String   @default("main") @db.VarChar(50)
  settings       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  application          Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  installation         GithubInstallation   @relation(fields: [installationId], references: [installationId])
  codebaseEmbeddings   CodebaseEmbedding[]
  codebaseIndexStatus  CodebaseIndexStatus?

  @@unique([applicationId, owner, repo])
  @@index([applicationId])
  @@map("project_github_configs")
}

model GithubWebhookEvent {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installationId BigInt?   @map("installation_id")
  eventType      String    @map("event_type")
  action         String?
  payload        Json
  processed      Boolean   @default(false)
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@index([installationId])
  @@index([processed])
  @@index([createdAt])
  @@map("github_webhook_events")
}

// ═══════════════════════════════════════════════════════════════════════
// THIRD-PARTY INTEGRATIONS
// ═══════════════════════════════════════════════════════════════════════

model Integration {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  type        String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  enabled     Boolean  @default(true)

  // Encrypted configuration (API keys, tokens, workspace IDs)
  config      String   @db.Text
  configIv    String   @map("config_iv") @db.VarChar(32)

  // Field mappings (severity->priority, status->state, etc.)
  mappings    Json?    @default("{}")

  // OAuth tokens (if applicable)
  accessToken     String?  @map("access_token") @db.Text
  refreshToken    String?  @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime? @map("token_expires_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  lastSyncedAt DateTime? @map("last_synced_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncLogs    IntegrationSyncLog[]

  @@unique([tenantId, type, name])
  @@index([tenantId])
  @@index([tenantId, enabled])
  @@map("integrations")
}

model IntegrationSyncLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid

  externalId    String?  @map("external_id") @db.VarChar(500)
  action        String?  @db.VarChar(20)
  durationMs    Int?     @map("duration_ms")
  externalUrl   String?  @map("external_url") @db.Text
  triggeredBy   String?  @map("triggered_by") @db.VarChar(20)
  provider      String?  @db.VarChar(50)
  status        String   @db.VarChar(50)
  attemptCount  Int      @default(1) @map("attempt_count")

  error         String?  @db.Text
  metadata      Json?    @default("{}")

  syncedAt      DateTime @default(now()) @map("synced_at")

  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  ticket        Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([ticketId])
  @@index([status])
  @@index([action])
  @@map("integration_sync_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// AI CONFIGURATION (BYOK)
// ═══════════════════════════════════════════════════════════════════════

model AiConfig {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  provider        String   @default("anthropic") @db.VarChar(50)
  encryptedApiKey String   @map("encrypted_api_key") @db.Text
  model           String   @default("claude-sonnet-4-20250514") @db.VarChar(100)
  settings        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_configs")
}

// ═══════════════════════════════════════════════════════════════════════
// TENANT QUOTAS
// ═══════════════════════════════════════════════════════════════════════

model TenantQuota {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  plan         String   @default("free") @db.VarChar(20) // free, pro, enterprise
  monthlyQuota Int      @default(10) @map("monthly_quota")
  currentUsage Int      @default(0) @map("current_usage")
  quotaResetAt DateTime @map("quota_reset_at")
  isByok       Boolean  @default(false) @map("is_byok")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_quotas")
}

// ═══════════════════════════════════════════════════════════════════════
// AI AGENT & CONVERSATIONS
// ═══════════════════════════════════════════════════════════════════════

model AgentSession {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId         String    @map("ticket_id") @db.Uuid
  status           String    @default("active") @db.VarChar(50)
  agentState       Json      @default("{}") @map("agent_state")
  lastActionAt     DateTime  @default(now()) @map("last_action_at")
  escalatedTo      String?   @map("escalated_to") @db.Uuid
  escalationReason  String?   @map("escalation_reason") @db.Text
  anthropicMessages Json?     @map("anthropic_messages") @db.JsonB
  toolCallLog       Json?     @map("tool_call_log") @db.JsonB
  agentLevel        String?   @map("agent_level") @db.VarChar(50)
  modelUsed         String?   @map("model_used") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")

  ticket    Ticket         @relation(fields: [ticketId], references: [id])
  escalatee User?          @relation(fields: [escalatedTo], references: [id])
  messages  AgentMessage[]

  @@index([ticketId])
  @@map("agent_sessions")
}

model AgentMessage {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  role       String   @db.VarChar(50)
  content    String   @db.Text
  channel    String?  @db.VarChar(50)
  externalId String?  @map("external_id") @db.VarChar(255)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  session AgentSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("agent_messages")
}

// ═══════════════════════════════════════════════════════════════════════
// FEEDBACK & LEARNING
// ═══════════════════════════════════════════════════════════════════════

model ClassificationFeedback {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  field          String   @db.VarChar(50)
  originalValue  String?  @map("original_value") @db.VarChar(100)
  correctedValue String?  @map("corrected_value") @db.VarChar(100)
  correctedBy    String?  @map("corrected_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  corrector User?  @relation(fields: [correctedBy], references: [id])

  @@map("classification_feedback")
}

// ═══════════════════════════════════════════════════════════════════════
// CODEBASE INDEXING & EMBEDDINGS
// ═══════════════════════════════════════════════════════════════════════

model CodebaseEmbedding {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  repoConfigId  String?  @map("repo_config_id") @db.Uuid
  filePath      String   @map("file_path") @db.VarChar(500)
  chunkIndex    Int      @map("chunk_index")
  content       String   @db.Text
  embedding     Unsupported("vector(1536)")?
  language      String   @db.VarChar(20)
  lastCommitSha String   @map("last_commit_sha") @db.VarChar(40)
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  repoConfig  ProjectGithubConfig? @relation(fields: [repoConfigId], references: [id], onDelete: SetNull)

  @@unique([applicationId, filePath, chunkIndex])
  @@index([tenantId, applicationId])
  @@index([applicationId, filePath])
  @@index([repoConfigId])
  @@map("codebase_embeddings")
}

model CodebaseIndexStatus {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  applicationId   String    @unique @map("application_id") @db.Uuid
  repoConfigId    String?   @unique @map("repo_config_id") @db.Uuid
  status          String    @default("idle") @db.VarChar(20)
  lastIndexedAt   DateTime? @map("last_indexed_at")
  lastCommitSha   String?   @map("last_commit_sha") @db.VarChar(40)
  totalFiles      Int       @default(0) @map("total_files")
  totalChunks     Int       @default(0) @map("total_chunks")
  error           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  repoConfig  ProjectGithubConfig? @relation(fields: [repoConfigId], references: [id], onDelete: SetNull)

  @@map("codebase_index_status")
}

// ═══════════════════════════════════════════════════════════════════════
// AI AGENT TASKS
// ═══════════════════════════════════════════════════════════════════════

model AgentTask {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId        String    @map("ticket_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  applicationId   String    @map("application_id") @db.Uuid
  status          String    @default("analyzing") @db.VarChar(50)
  actionPlan      Json?     @map("action_plan") @db.JsonB
  executionLog    Json      @default("[]") @map("execution_log") @db.JsonB
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  error           String?   @db.Text

  // CI retry tracking
  retryCount      Int       @default(0) @map("retry_count")
  ciErrorLog      String?   @map("ci_error_log") @db.Text

  // Review tracking (US-3.4)
  reviewRequestedAt DateTime? @map("review_requested_at")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedBy        String?   @map("reviewed_by") @db.VarChar(255)
  rejectionReason   String?   @map("rejection_reason") @db.Text

  // PR tracking
  prNumber        Int?      @map("pr_number")
  prUrl           String?   @map("pr_url") @db.Text
  branchName      String?   @map("branch_name") @db.VarChar(255)

  diagnosisSnapshot Json?     @map("diagnosis_snapshot") @db.JsonB

  // Multi-repo support
  repoConfigId    String?   @map("repo_config_id") @db.Uuid
  taskGroupId     String?   @map("task_group_id") @db.Uuid

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ticket      Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId, status])
  @@index([applicationId])
  @@index([taskGroupId])
  @@map("agent_tasks")
}

// ═══════════════════════════════════════════════════════════════════════
// TICKET EVENTS / TIMELINE
// ═══════════════════════════════════════════════════════════════════════

model TicketEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(100)
  data      Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([tenantId])
  @@map("ticket_events")
}

// ═══════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════════════

model NotificationPreference {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  channel       String   @db.VarChar(50)
  events        String[] @default([])
  config        Json     @default("{}")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([tenantId])
  @@map("notification_preferences")
}

model NotificationLog {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  channel   String   @db.VarChar(50)
  eventType String   @map("event_type") @db.VarChar(100)
  status    String   @default("pending") @db.VarChar(50)
  metadata  Json     @default("{}")
  error     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([tenantId])
  @@index([status])
  @@map("notification_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// TICKET MESSAGES
// ═══════════════════════════════════════════════════════════════════════

model TicketMessage {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId    String   @map("ticket_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  type        String   @db.VarChar(50) // "system", "user", "agent", "diagnosis", "action_plan", "pr_status"
  content     String   @db.Text
  sender      String   @db.VarChar(255)
  metadata    Json?    @default("{}")
  actionState String?  @map("action_state") @db.VarChar(20) // "pending", "approved", "rejected", null
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ticket  Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  parent  TicketMessage? @relation("MessageThread", fields: [parentId], references: [id])
  replies TicketMessage[] @relation("MessageThread")

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@index([parentId])
  @@map("ticket_messages")
}

// ═══════════════════════════════════════════════════════════════════════
// SYSTEM CONFIG
// ═══════════════════════════════════════════════════════════════════════

model SystemConfig {
  key       String   @id @db.VarChar(255)
  value     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ═══════════════════════════════════════════════════════════════════════
// LICENSE & USAGE TRACKING
// ═══════════════════════════════════════════════════════════════════════

model LicenseUsage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  month     String   @db.VarChar(7) // "2026-02"
  metric    String   @db.VarChar(50) // "tickets", "agent_tasks", "users"
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month, metric])
  @@index([tenantId])
  @@map("license_usage")
}

// ═══════════════════════════════════════════════════════════════════════
// AUDIT LOGS
// ═══════════════════════════════════════════════════════════════════════

model AuditLog {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.VarChar(255)
  actorType    String   @map("actor_type") @db.VarChar(50) // "user", "system", "agent"
  action       String   @db.VarChar(100) // "login", "create_user", "update_settings", etc.
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(255)
  details      Json?    @default("{}")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// SSO / ENTERPRISE AUTH
// ═══════════════════════════════════════════════════════════════════════

model SsoConfig {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String   @unique @map("tenant_id") @db.Uuid
  providerType    String   @map("provider_type") @db.VarChar(20) // "saml", "oidc"
  enabled         Boolean  @default(false)
  config          String   @db.Text // encrypted SAML/OIDC settings (ciphertext)
  configIv        String   @map("config_iv") @db.VarChar(32) // initialization vector for encryption
  roleMapping     Json     @default("{}") @map("role_mapping") // IdP groups → app roles
  autoProvision   Boolean  @default(true) @map("auto_provision")
  disablePassword Boolean  @default(false) @map("disable_password") // disable email/password login
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sso_config")
}

// ═══════════════════════════════════════════════════════════════════════
// DEAD LETTER QUEUE ARCHIVE
// ═══════════════════════════════════════════════════════════════════════

model ArchivedDeadLetterJob {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid // nullable for system-level jobs
  queueName     String   @map("queue_name") @db.VarChar(100)
  jobId         String   @map("job_id") @db.VarChar(255)
  jobName       String?  @map("job_name") @db.VarChar(255)
  jobData       Json     @map("job_data")
  failedReason  String?  @map("failed_reason") @db.Text
  stackTrace    String[] @map("stack_trace")
  attemptsMade  Int      @map("attempts_made")
  processedAt   DateTime @map("processed_at") // when it was originally processed by DLQ
  archivedAt    DateTime @default(now()) @map("archived_at") // when it was archived
  ticketId      String?  @map("ticket_id") @db.Uuid // extracted from jobData for quick lookups
  applicationId String?  @map("application_id") @db.Uuid

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, archivedAt(sort: Desc)])
  @@index([queueName, archivedAt(sort: Desc)])
  @@index([ticketId])
  @@index([archivedAt]) // for cleanup queries
  @@map("archived_dead_letter_jobs")
}

// ═══════════════════════════════════════════════════════════════════════
// TICKET RELATIONS
// ═══════════════════════════════════════════════════════════════════════

enum TicketRelationType {
  duplicate
  similar
  related
}

model TicketRelation {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  sourceTicketId  String             @map("source_ticket_id") @db.Uuid
  targetTicketId  String             @map("target_ticket_id") @db.Uuid
  relationType    TicketRelationType @map("relation_type")
  createdBy       String             @map("created_by") @db.VarChar(20) // "ai" or "manual"
  confidence      Decimal?           @db.Decimal(3, 2)
  metadata        Json?              @default("{}") @db.JsonB
  createdAt       DateTime           @default(now()) @map("created_at")

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceTicket Ticket @relation("SourceTicket", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicket Ticket @relation("TargetTicket", fields: [targetTicketId], references: [id], onDelete: Cascade)

  @@unique([sourceTicketId, targetTicketId, relationType])
  @@index([sourceTicketId])
  @@index([targetTicketId])
  @@index([tenantId])
  @@map("ticket_relations")
}
